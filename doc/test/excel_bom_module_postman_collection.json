{
	"info": {
		"_postman_id": "7f8b9e10-c4a3-4812-98e1-f63901b0a721",
		"name": "Excel & BOM Module API Test Collection",
		"description": "遵循 DDD 與 Clean Architecture 六角形架構之 Excel 模組與 BOM 物料清單 API 完整自動化測試集合。\n包含 BOM 多階層/單階 Excel 下載、大數據百萬級串流匯出/匯入與異常校驗測試。",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8080",
			"type": "string",
			"description": "本機後端服務基礎 URL"
		}
	],
	"item": [
		{
			"name": "1. BOM 物料清單模組 (BOM Module)",
			"description": "物料清單 (BOM) Excel 檔案動態產生、多階層展開、單階平鋪格式與物料對照表下載 API",
			"item": [
				{
					"name": "GET 下載指定母件多階層 BOM (MAT-FG-001)",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/v1/bom/excel?parentMaterialCode=MAT-FG-001&includeMultiLevel=true&includeSingleLevel=true&includeMaterialMaster=true",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"bom",
								"excel"
							],
							"query": [
								{
									"key": "parentMaterialCode",
									"value": "MAT-FG-001",
									"description": "母件物料料號 (工業級四軸無人機旗艦套件)"
								},
								{
									"key": "includeMultiLevel",
									"value": "true",
									"description": "是否包含多階層樹狀展開工作表"
								},
								{
									"key": "includeSingleLevel",
									"value": "true",
									"description": "是否包含單階匯入格式工作表"
								},
								{
									"key": "includeMaterialMaster",
									"value": "true",
									"description": "是否包含物料主檔對照表"
								}
							]
						},
						"description": "下載特定成品 (MAT-FG-001) 之完整 3 工作表 Excel (多階展開、單階平鋪、物料對照表)。"
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"狀態碼為 200 OK\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"pm.test(\"Content-Type 為 Excel openxml 格式\", function () {",
									"    pm.response.to.have.header(\"Content-Type\");",
									"    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"spreadsheetml.sheet\");",
									"});",
									"pm.test(\"Content-Disposition 標頭包含正確 attachment 與料號檔名\", function () {",
									"    var disposition = pm.response.headers.get(\"Content-Disposition\");",
									"    pm.expect(disposition).to.include(\"attachment\");",
									"    pm.expect(disposition).to.include(\"MAT-FG-001\");",
									"    pm.expect(disposition).to.include(\".xlsx\");",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"response": []
				},
				{
					"name": "GET 下載指定母件特定版本 BOM (MAT-FG-001 V1.0)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/v1/bom/excel?parentMaterialCode=MAT-FG-001&version=V1.0",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"bom",
								"excel"
							],
							"query": [
								{
									"key": "parentMaterialCode",
