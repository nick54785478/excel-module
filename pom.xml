<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.2</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.example</groupId>
	<artifactId>excel-module</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>excel-module</name>
	<description>Demo project for Spring Boot</description>
	<url/>
	<licenses>
		<license/>
	</licenses>
	<developers>
		<developer/>
	</developers>
	<scm>
		<connection/>
		<developerConnection/>
		<tag/>
		<url/>
	</scm>
	<!-- ========================================================================= -->
	<!-- 專案建置環境與套件版本常數設定 (Project Properties)                           -->
	<!-- ========================================================================= -->
	<properties>
		<!-- 系統編譯與執行之 Java 語言版本 (Java 22) -->
		<java.version>22</java.version>
		<maven.compiler.source>22</maven.compiler.source>
		<maven.compiler.target>22</maven.compiler.target>
		<maven.compiler.release>22</maven.compiler.release>
		<!-- 原始碼與建置報表統一編碼標準 -->
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
		<!-- 核心框架與輔助工具版本常數 -->
		<spring-boot.version>4.1.2</spring-boot.version>
		<lombok.version>1.18.48</lombok.version>
	</properties>
	<!-- ========================================================================= -->
	<!-- 相依版本統一管理 (Dependency Management / Bill of Materials)                  -->
	<!-- ========================================================================= -->
	<dependencyManagement>
		<dependencies>
			<!-- Spring Boot 核心依賴版本 BOM：統一管理 Spring 生態系各模組相容版本 -->
			<dependency>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-dependencies</artifactId>
				<version>${spring-boot.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<dependencies>
		<!-- ===================================================================== -->
		<!-- 1. Spring Boot 核心框架與 WebMVC 表現層模組                           -->
		<!-- ===================================================================== -->

		<!-- Spring Boot 核心執行環境模組：提供 Context、Lifecycle 與核心底層支援 -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot</artifactId>
			<version>${spring-boot.version}</version>
		</dependency>

		<!-- Spring Boot 自動化配置機制 (Auto-Configuration)：依賴注入與條件式裝配 (@ConditionalOn...) -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-autoconfigure</artifactId>
			<version>${spring-boot.version}</version>
		</dependency>

		<!-- Spring Boot 基礎啟動器 (Starter)：內含 Spring Core、日誌框架 (Logback/SLF4J) 與 YAML 設定解析 -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter</artifactId>
			<version>${spring-boot.version}</version>
		</dependency>

		<!-- Spring Web MVC 模組：負責表現層 REST API 控制器 (Controller)、HTTP 請求/回應封裝與 Excel 二進位檔案下載串流 -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
			<version>${spring-boot.version}</version>
		</dependency>

		<!-- ===================================================================== -->
		<!-- 2. API 文件生成與請求參數驗證                                         -->
		<!-- ===================================================================== -->

		<!-- Jakarta Bean Validation (Hibernate Validator)：表現層 Request 資源屬性檢核 (@Valid, @NotNull, @NotEmpty, @Size 等) -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
			<version>${spring-boot.version}</version>
		</dependency>

		<!-- SpringDoc OpenAPI 3 / Swagger UI 互動式 API 文件模組：自動產生 REST API 規格文件與互動除錯介面 -->
		<dependency>
			<groupId>org.springdoc</groupId>
			<artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
			<version>3.1.1</version>
		</dependency>

		<!-- ===================================================================== -->
		<!-- 3. 基礎設施層：資料庫存取與持久化 (Infrastructure Persistence)         -->
		<!-- ===================================================================== -->

		<!-- Spring Data JPA & Hibernate ORM：負責 Task、Material 與 BOM 等基礎設施實體持久化與儲存庫存取 -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
			<version>${spring-boot.version}</version>
		</dependency>

		<!-- H2 Web Console 整合模組：提供瀏覽器圖形化介面以即時檢視記憶體資料庫結構與執行 SQL 查驗 -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-h2console</artifactId>
			<version>${spring-boot.version}</version>
		</dependency>

		<!-- H2 Database 嵌入式/記憶體關聯式資料庫：用於本機開發、快速開機啟動與單元/整合測試沙箱 -->
		<dependency>
			<groupId>com.h2database</groupId>
			<artifactId>h2</artifactId>
			<version>2.4.240</version>
			<scope>runtime</scope>
		</dependency>

		<!-- MySQL Connector/J JDBC 驅動：用於正式環境或外部實體 MySQL 關聯式資料庫連線支援 -->
		<dependency>
			<groupId>com.mysql</groupId>
			<artifactId>mysql-connector-j</artifactId>
			<version>9.7.0</version>
			<scope>runtime</scope>
		</dependency>

		<!-- ===================================================================== -->
		<!-- 4. 核心領域支援：高效能 Excel 處理引擎 (FastExcel & Apache POI)        -->
		<!-- ===================================================================== -->

		<!-- FastExcel 串流寫入引擎：專為大數據量設計的高效能、低記憶體損耗 Excel 寫入引擎 (維度四串流匯出核心) -->
		<dependency>
			<groupId>org.dhatim</groupId>
			<artifactId>fastexcel</artifactId>
			<version>0.20.2</version>
		</dependency>

		<!-- FastExcel Reader 串流讀取引擎：高吞吐量、逐列串流讀取大檔案，避免巨量資料造成 Out-Of-Memory (OOM) -->
		<dependency>
			<groupId>org.dhatim</groupId>
			<artifactId>fastexcel-reader</artifactId>
			<version>0.20.2</version>
		</dependency>

		<!-- Apache POI 核心基礎庫：提供 Microsoft Office 檔案格式底層抽象、樣式、色彩與字型支援 -->
		<dependency>
			<groupId>org.apache.poi</groupId>
			<artifactId>poi</artifactId>
			<version>5.5.1</version>
		</dependency>

		<!-- Apache POI OOXML (XSSF / SXSSF)：支援維度五企業級進階樣式、儲存格跨欄合併、動態公式計算 (SUM/四則運算)、工作表密碼防護與列印標籤 -->
		<dependency>
			<groupId>org.apache.poi</groupId>
			<artifactId>poi-ooxml</artifactId>
			<version>5.5.1</version>
		</dependency>

		<!-- ===================================================================== -->
		<!-- 5. 規則引擎：宣告式業務驗證與錯誤標記管道 (EasyRules)                  -->
		<!-- ===================================================================== -->

		<!-- EasyRules 輕量級規則引擎核心：支援維度三宣告式檢核管線、自訂業務驗證規則鏈與錯誤儲存格標記回饋機制 -->
		<dependency>
			<groupId>org.jeasy</groupId>
			<artifactId>easy-rules-core</artifactId>
			<version>4.1.0</version>
		</dependency>

		<!-- ===================================================================== -->
		<!-- 6. 開發工具與程式碼生成輔助 (Lombok)                                   -->
		<!-- ===================================================================== -->

		<!--
			Lombok 輔助套件：自動生成 getter/setter/builder 等 boilerplate 代碼。
			【重要規範】遵循 AGENTS.md 規則 8：Domain Aggregate 內部嚴禁使用 Lombok，
			以維護領域模型的封裝性；本套件僅限基礎設施層實體或特定配置類別輔助使用。
		-->
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<version>${lombok.version}</version>
			<optional>true</optional>
		</dependency>

		<!-- ===================================================================== -->
		<!-- 7. 單元測試與切片整合測試套件 (Testing & Verification)                 -->
		<!-- ===================================================================== -->

		<!-- Spring Data JPA 專用測試套件：支援 @DataJpaTest 切片測試、測試資料庫自動替換與 Repository 單元驗證 -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa-test</artifactId>
			<version>${spring-boot.version}</version>
			<scope>test</scope>
		</dependency>

		<!-- Spring Web MVC 專用測試套件：支援 MockMvc、WebMvcTest 切片測試、REST Controller 介面規格與 HTTP 斷言驗證 -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<version>${spring-boot.version}</version>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<!-- ========================================================================= -->
	<!-- 建置流程與外掛程式設定 (Build & Plugins Configuration)                        -->
	<!-- ========================================================================= -->
	<build>
		<plugins>
			<!-- Maven Java 編譯器外掛：配置編譯參數、字節碼相容性與註解處理器 (Annotation Processors) -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<configuration>
					<release>21</release>
					<parameters>true</parameters>
					<compilerArgs>
						<!-- 保留方法參數名稱 (Method Parameter Names) 反射中繼資料，供 Spring Web 與 Validation 依賴注入使用 -->
						<arg>-parameters</arg>
					</compilerArgs>
					<annotationProcessorPaths>
						<!-- Lombok 編譯期程式碼產生器路徑 -->
						<path>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
							<version>${lombok.version}</version>
						</path>
					</annotationProcessorPaths>
				</configuration>
			</plugin>

			<!-- Spring Boot 打包外掛：將應用程式組裝為可直接以 java -jar 執行的 Fat JAR 檔 -->
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<excludes>
						<!-- 打包階段排除 Lombok 依賴，避免不必要的編譯工具外洩至 Production 執行階段 -->
						<exclude>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
						</exclude>
					</excludes>
				</configuration>
			</plugin>
		</plugins>
	</build>

</project>
